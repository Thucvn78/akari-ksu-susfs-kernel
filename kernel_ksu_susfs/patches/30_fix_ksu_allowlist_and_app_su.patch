     ret = ksu_set_app_profile(&cmd.profile);
     if (!ret) {
         ksu_persistent_allow_list();
+#ifdef CONFIG_KSU_SUSFS
+        {
+            struct task_struct *p, *t;
+            read_lock(&tasklist_lock);
+            for_each_process_thread(p, t) {
+                if (t->pid != 1 && !t->mm)
+                    continue;
