+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0) ||                           \
+	defined(CONFIG_IS_HW_HISI) || defined(CONFIG_KSU_ALLOWLIST_WORKAROUND)
+extern int install_session_keyring_to_cred(struct cred *cred, struct key *keyring);
+
+static struct cred *ksu_cred_with_init_keyring(void)
+{
+	struct cred *cred;
+
+	if (!init_session_keyring)
+		return NULL;
+
+	cred = prepare_creds();
+	if (!cred)
+		return NULL;
+
+	if (install_session_keyring_to_cred(cred, init_session_keyring) < 0) {
+		abort_creds(cred);
+		return NULL;
+	}
+	return cred;
+}
+#endif
+
 struct file *ksu_filp_open_compat(const char *filename, int flags, umode_t mode)
 {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0) ||                           \
+	defined(CONFIG_IS_HW_HISI) || defined(CONFIG_KSU_ALLOWLIST_WORKAROUND)
+	struct cred *cred = ksu_cred_with_init_keyring();
+	if (cred) {
+		const struct cred *old_cred = override_creds(cred);
+		struct file *f = filp_open(filename, flags, mode);
+		revert_creds(old_cred);
+		put_cred(cred);
+		return f;
+	}
+#endif
 	return filp_open(filename, flags, mode);
 }
 
+struct file *ksu_filp_open_nonotify_compat(const char *path, int flags)
+{
+	struct path p;
+	struct file *f;
+	int ret;
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0) ||                           \
+	defined(CONFIG_IS_HW_HISI) || defined(CONFIG_KSU_ALLOWLIST_WORKAROUND)
+	struct cred *cred = ksu_cred_with_init_keyring();
+	const struct cred *old_cred = cred ? override_creds(cred) : NULL;
+#endif
+
+	ret = kern_path(path, (flags & O_NOFOLLOW) ? 0 : LOOKUP_FOLLOW, &p);
+	if (ret) {
+		f = ERR_PTR(ret);
+		goto out;
+	}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0)
+	f = dentry_open_nonotify(&p, flags, current_cred());
+#else
+	f = dentry_open(&p, flags | __FMODE_NONOTIFY, current_cred());
+#endif
+	path_put(&p);
+
+out:
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 10, 0) ||                           \
+	defined(CONFIG_IS_HW_HISI) || defined(CONFIG_KSU_ALLOWLIST_WORKAROUND)
+	if (cred) {
+		revert_creds(old_cred);
+		put_cred(cred);
+	}
+#endif
+	return f;
+}
